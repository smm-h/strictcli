[
  {
    "name": "mcp_baseline: tools/list publishes one tool per leaf command",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "status",
          "help": "show status",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "ok": true
            }
          }
        }
      ],
      "groups": [
        {
          "name": "dns",
          "help": "manage DNS",
          "commands": [
            {
              "name": "zone-list",
              "help": "list DNS zones",
              "effect": "read_only",
              "handler_returns": {
                "kind": "data",
                "data": {
                  "zones": 1
                }
              }
            }
          ],
          "groups": [
            {
              "name": "zone",
              "help": "manage zones",
              "commands": [
                {
                  "name": "create",
                  "help": "create a zone",
                  "effect": "read_only",
                  "handler_returns": {
                    "kind": "data",
                    "data": {
                      "created": true
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "acknowledged_divergence": {
      "reason": "The MCP JSON-RPC wire form is produced by each language's own JSON encoder, which is not part of the contract: Python's json.dumps inserts a space after every separator, and Go's encoding/json sorts map keys. The scripted assertions are structural (json_equals parses each line), so they are identical for all three targets and are what pins the protocol; only the raw bytes of the whole stream diverge. Go's stream diverges for a second, non-encoder reason this baseline records deliberately: it publishes tool names with dots replaced by underscores (dns.zone.create becomes dns_zone_create), while Python and TypeScript publish the dotted command path. The name is asserted as $ANY here; the two target-restricted cases below pin each spelling exactly.",
      "streams": {
        "stdout": [
          "python",
          "go"
        ]
      }
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "tools": [
                {
                  "name": "status",
                  "description": "show status",
                  "effect": "read_only",
                  "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                },
                {
                  "name": "$ANY",
                  "description": "list DNS zones",
                  "effect": "read_only",
                  "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                },
                {
                  "name": "$ANY",
                  "description": "create a zone",
                  "effect": "read_only",
                  "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                }
              ]
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  },
