  {
    "name": "mutex: help shows mutually exclusive section",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "name",
              "type": "str",
              "help": "your name",
              "default": "anon"
            }
          ],
          "mutex": [
            {
              "flags": [
                {
                  "name": "chatter",
                  "type": "bool",
                  "help": "chatter output"
                },
                {
                  "name": "muted",
                  "type": "bool",
                  "help": "muted output"
                }
              ]
            }
          ],
          "handler_prints": "ok"
        }
      ]
    },
    "argv": [
      "cmd",
      "--help"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": [
        "Flags (mutually exclusive):",
        "--chatter",
        "--muted",
        "Flags:",
        "--name"
      ],
      "stdout_equals": "myapp cmd -- a command\n\nFlags:\n  --name <str>    your name [default: anon]\n\nFlags (mutually exclusive):\n  --chatter, --no-chatter    chatter output [required]\n  --muted, --no-muted        muted output [required]"
    }
  },
