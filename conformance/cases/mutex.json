[
  {
    "name": "mutex: neither provided is error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "mutex": [
            {
              "flags": [
                {
                  "name": "chatter",
                  "type": "bool",
                  "help": "chatter output"
                },
                {
                  "name": "muted",
                  "type": "bool",
                  "help": "muted output"
                }
              ]
            }
          ],
          "handler_prints": "chatter={chatter} muted={muted}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": [
        "one of",
        "is required"
      ]
    }
  },
