[
  {
    "name": "zzhelp: probe",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "target",
              "help": "the target",
              "presence": "required"
            }
          ],
          "flags": [
            {
              "name": "req",
              "help": "required flag",
              "presence": "required"
            },
            {
              "name": "opt",
              "help": "optional flag",
              "presence": "optional"
            },
            {
              "name": "lvl",
              "help": "level",
              "presence": "default",
              "default": "info"
            },
            {
              "name": "onoff",
              "type": "bool",
              "help": "a bool",
              "presence": "default",
              "default": true
            },
            {
              "name": "offon",
              "type": "bool",
              "help": "another bool",
              "presence": "default",
              "default": false
            },
            {
              "name": "tags",
              "type": "list[str]",
              "help": "tags",
              "presence": "default",
              "default": [],
              "unique": false
            },
            {
              "name": "hdrs",
              "type": "dict[str,str]",
              "help": "headers",
              "presence": "default",
              "default": {}
            },
            {
              "name": "pairs",
              "type": "dict[str,int]",
              "help": "pairs",
              "presence": "default",
              "default": {
                "b": 2,
                "a": 1
              }
            },
            {
              "name": "nums",
              "type": "list[int]",
              "help": "nums",
              "presence": "default",
              "default": [
                1,
                2
              ],
              "unique": false
            }
          ],
          "handler_prints": "x"
        }
      ]
    },
    "argv": [
      "cmd",
      "--help"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": "ZZZ"
    }
  },
  {
    "name": "zzhelp: arg probe",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "a1",
              "help": "required arg",
              "presence": "required"
            },
            {
              "name": "a2",
              "help": "optional arg",
              "presence": "optional"
            },
            {
              "name": "a3",
              "help": "defaulted arg",
              "presence": "default",
              "default": "out.txt"
            },
            {
              "name": "a4",
              "type": "bool",
              "help": "bool arg",
              "presence": "default",
              "default": true
            }
          ],
          "handler_prints": "x"
        }
      ]
    },
    "argv": [
      "cmd",
      "--help"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": "ZZZ"
    }
  },
  {
    "name": "zzhelp: app summary probe",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "gopt",
          "help": "a global",
          "presence": "optional"
        },
        {
          "name": "greq",
          "help": "another global",
          "presence": "required"
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "x"
        }
      ]
    },
    "argv": [
      "--help"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": "ZZZ"
    }
  }
]
