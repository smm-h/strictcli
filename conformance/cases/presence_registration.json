[
  {
    "name": "presence registration: a flag declaring nothing does not register (python)",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "level",
              "help": "the level"
            }
          ],
          "handler_prints": "level={level}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: Flag \"level\": presence is undeclared: declare exactly one of presence=\"required\", presence=\"optional\", or default=<value>"
    },
    "skip_schema_validation": true,
    "targets": [
      "python"
    ]
  },
