  {
    "name": "presence registration: a variadic arg cannot declare a default (python)",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "files",
              "help": "files to process",
              "presence": "default",
              "default": "none.txt",
              "variadic": true
            }
          ],
          "handler_prints": "files={files}"
        }
      ]
    },
    "argv": [
      "cmd",
      "a"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: Arg \"files\": a variadic arg cannot declare default=: it always delivers a list, so declare presence=\"required\" for at least one value or presence=\"optional\" for possibly none"
