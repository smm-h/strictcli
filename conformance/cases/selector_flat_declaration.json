[
  {
    "name": "flat declaration: the command line refuses a scoped value outside its closed set",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "handler_prints": "fmt={via.fmt} prov={provided:via.fmt}",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "fmt",
                      "help": "body format of the message",
                      "type": "str",
                      "presence": "default",
                      "default": "text",
                      "choices_str": [
                        { "value": "text", "help": "a plain-text body" },
                        { "value": "json", "help": "a structured body" }
                      ]
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number",
                      "type": "str",
                      "presence": "optional"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": ["send", "--via", "email", "--fmt", "xml"],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: --fmt: invalid value 'xml', must be one of: text, json\ntry 'myapp send --help'\n"
    }
  },
  {
    "name": "flat declaration: the flat door refuses a scoped value outside its closed set",
    "acknowledged_divergence": {
      "reason": "The MCP JSON-RPC wire form is produced by each language's own JSON encoder, which is not part of the contract: Python's json.dumps inserts a space after every separator, and Go's encoding/json sorts map keys. The scripted assertions are structural (json_equals / matches parse or search the line), so they are identical for all three targets and are what pins the projection; only the raw bytes of the whole stream diverge.",
      "streams": { "stdout": ["python", "go"] }
    },
    "app": {
