                        { "value": "json", "help": "a structured body" }
                      ]
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number",
                      "type": "str",
                      "presence": "optional"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": ["--mcp"],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"send\", \"arguments\": {\"via\": \"email\", \"fmt\": \"xml\"}, \"_meta\": {\"io.modelcontextprotocol/protocolVersion\": \"2026-07-28\", \"io.modelcontextprotocol/clientCapabilities\": {}}}}",
        "expect_line": {
