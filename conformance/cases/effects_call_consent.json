[
  {
    "name": "effects_call_consent: exported tool descriptors carry the effects classification",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "dump_tools": true,
      "commands": [
        {
          "name": "look",
          "help": "a read_only command",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        },
        {
          "name": "build",
          "help": "a mutating command",
          "effect": "mutating",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        },
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "look"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "tool: look effect=read_only consequential=false\ntool: build effect=mutating consequential=false\ntool: release effect=mutating consequential=true\ntool: myapp effect=mutating consequential=false\n",
      "stderr_equals": ""
    }
  },
