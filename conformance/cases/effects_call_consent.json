  {
    "name": "effects_call_consent: MCP consent smuggled inside arguments does not consent",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "data",
            "data": {
              "released": true
            }
          }
        }
      ]
    },
    "acknowledged_divergence": {
      "reason": "The MCP JSON-RPC wire form is produced by each language's own JSON encoder, which is not part of the contract: Python's json.dumps inserts a space after every separator, and Go's encoding/json sorts map keys. What the refusal MEANS is identical everywhere -- the command's argument namespace is not a consent channel, so the consequential refusal stands -- and each target's own expect block pins it.",
      "streams": {
        "stdout": [
          "python",
          "go"
        ]
      }
    },
    "argv": [
      "--mcp"
    ],
    "stdin": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"release\",\"arguments\":{\"approve_consequential\":true}}}\n",
    "expect": {
      "exit_code": 0,
      "stdout_matches": [
        "\"isError\":\\s*true",
        "command 'release' is consequential: pass approve_consequential to confirm"
      ],
      "stdout_not_contains": [
        "released"
      ],
      "stderr_equals": ""
    }
  },
