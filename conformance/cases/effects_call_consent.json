  {
    "name": "effects_call_consent: MCP tools/call refuses a consequential tool without consent",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "data",
            "data": {
              "released": true
            }
          }
        }
      ]
    },
    "acknowledged_divergence": {
      "reason": "The MCP JSON-RPC wire form is produced by each language's own JSON encoder, which is not part of the contract: Python's json.dumps inserts a space after every separator, and Go's encoding/json sorts map keys. What the classification and the consent refusal mean is identical everywhere, and each target's own expect block pins it.",
      "streams": {
        "stdout": [
          "python",
          "go"
        ]
      }
    },
    "argv": [
      "--mcp"
    ],
    "stdin": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"release\"}}\n",
    "expect": {
      "exit_code": 0,
      "stdout_matches": [
        "\"isError\":\\s*true",
        "command 'release' is consequential: pass approve_consequential to confirm"
      ],
      "stderr_equals": ""
    }
  },
