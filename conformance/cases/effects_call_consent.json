    },
    "acknowledged_divergence": {
      "reason": "The MCP JSON-RPC wire form is produced by each language's own JSON encoder, which is not part of the contract: Python's json.dumps inserts a space after every separator, and Go's encoding/json sorts map keys. The protocol error code and message are identical everywhere, and each target's own expect block pins them.",
      "streams": {
        "stdout": [
          "python",
          "go"
        ]
      }
    },
    "argv": [
      "--mcp"
