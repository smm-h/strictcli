      "exit_code": 0,
      "stdout_matches": [
        "\"code\":\\s*-32602",
        "parameter 'approve_consequential' must be a boolean"
      ],
      "stdout_not_contains": [
        "released"
      ],
      "stderr_equals": ""
    }
  },
  {
    "name": "effects_call_consent: the consent name inside arguments is an unknown parameter of the command's own namespace",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "a plain mutating command",
          "effect": "mutating",
          "handler_returns": {
            "kind": "data",
            "data": {
              "built": true
            }
          }
        }
      ]
    },
    "acknowledged_divergence": {
      "reason": "The MCP JSON-RPC wire form is produced by each language's own JSON encoder, which is not part of the contract: Python's json.dumps inserts a space after every separator, and Go's encoding/json sorts map keys. The unknown-parameter message also quotes the name Python-style in Python and Go-style in Go and TypeScript. What it MEANS is identical everywhere: `approve_consequential` is reserved, no command can declare it, so inside `arguments` it can only be an unknown parameter -- never consent. Each target's own expect block pins it.",
      "streams": {
        "stdout": [
          "python",
          "go"
        ]
      }
    },
    "argv": [
      "--mcp"
    ],
    "stdin": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"build\",\"arguments\":{\"approve_consequential\":true}}}\n",
    "expect": {
      "exit_code": 0,
      "stdout_matches": [
        "\"isError\":\\s*true",
        "unknown parameter ['\\\\\"]{1,2}approve_consequential"
      ],
      "stdout_not_contains": [
        "built"
      ],
      "stderr_equals": ""
    }
  }
]
