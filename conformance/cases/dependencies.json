    "name": "dependencies: co_required both provided ok",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "output",
              "type": "str",
              "help": "output file",
              "presence": "default",
              "default": "none"
            },
            {
              "name": "format",
              "type": "str",
              "help": "output format",
              "presence": "default",
              "default": "none"
            }
          ],
          "dependencies": [
            {
              "type": "co_required",
              "flags": [
                "output",
                "format"
              ]
            }
          ],
          "handler_prints": "output={output} format={format}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--output",
      "file.txt",
      "--format",
      "json"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": [
        "output=file.txt",
        "format=json"
      ]
    }
  },
