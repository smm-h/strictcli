[
  {
    "name": "record door divergence: a selector value naming no choice of its own selector is refused everywhere",
    "acknowledged_divergence": {
      "reason": "Contract \u00a718.25 item 251: the three record doors are not carrying the same thing, so the refusal cannot be one sentence. A Go record holds a *ChoiceDecl -- a declared choice of SOME selector -- so it can say the choice is real and belongs elsewhere (errElectNotAChoice). A TypeScript record holds a string tag, which is a value that names a choice or does not, so the closed-set sentence the CLI already prints fits it exactly (errFlagInvalidChoice). A Python record is an instance of a class, so the refusal names the type it got against the union it declared. Forcing one spelling would make two of the three name something their runtime is not holding. The guarantee this case keeps asserting everywhere is the one that holds: every implementation refuses the call, on stderr, with the call channel's own prefix.",
      "streams": {
        "stderr": [
          "go",
          "typescript"
        ]
      }
    },
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "pre_call": [
        {
          "command": "send",
          "kwargs": {
            "target": {
              "choice": "simple"
            }
          }
        }
      ],
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "handler_prints": "mode={mode} target={target}",
          "flags": [
            {
              "name": "mode",
              "help": "operating mode",
              "presence": "default",
              "default": {
                "choice": "simple"
              },
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "advanced",
                  "help": "the mode that opens a rendering selection of its own",
                  "flags": [
                    {
                      "name": "format",
                      "help": "how the message body is rendered",
                      "presence": "required",
                      "elect_by": "selector-token",
                      "choices": [
                        {
                          "name": "plain",
                          "help": "no markup at all"
                        },
                        {
                          "name": "rich",
                          "help": "the full markup set"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "simple",
                  "help": "the mode that declares no rendering of its own"
                }
              ]
            },
            {
              "name": "target",
              "help": "which profiles to operate on",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "one-profile",
                  "help": "operate on a single profile"
                },
                {
                  "name": "all-profiles",
                  "help": "operate on every profile"
                }
              ]
            }
          ]
        },
        {
          "name": "noop",
          "help": "a command the case argv can run without output",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "noop"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "",
      "stderr_contains": "call error: "
    }
