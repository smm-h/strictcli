[
  {
    "name": "pairwise: type=str, presence=required, short, env, choices, repeatable",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "flag0",
              "type": "str",
              "help": "test flag 0",
              "presence": "required",
              "short": "s",
              "env": "MYAPP_FLAG0",
              "repeatable": true,
              "unique": false,
              "env_separator": ",",
              "choices_str": [
                "test_val",
                "other_val",
                "third_val"
              ]
            }
          ],
          "handler_prints": "flag0={flag0}"
        }
      ],
      "env_prefix": "MYAPP"
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "flag0=test_val,other_val"
    },
    "env": {
      "MYAPP_FLAG0": "test_val,other_val"
    }
  },
