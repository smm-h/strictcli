          "flags": [
            {
              "name": "flag1",
              "type": "bool",
              "help": "test flag 1",
              "presence": "default",
              "default": false,
              "negatable": true
            },
            {
              "name": "part1",
              "help": "co-required partner 1",
              "presence": "optional"
            }
          ],
          "dependencies": [
            {
              "type": "co_required",
              "flags": [
                "flag1",
                "part1"
              ]
            }
          ],
          "handler_prints": "flag1={flag1} part1={part1}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "flag1=false part1=None"
    }
  },
