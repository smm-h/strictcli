[
  {
    "name": "pairwise: type=str, presence=required, short, env, choices, repeatable, scoped",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "sel0",
              "help": "scope selector 0",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "on",
                  "help": "the scope that owns the subject flag",
                  "flags": [
                    {
                      "name": "flag0",
                      "type": "str",
                      "help": "test flag 0",
                      "presence": "required",
                      "short": "s",
                      "env": "MYAPP_FLAG0",
                      "repeatable": true,
                      "unique": false,
                      "env_separator": ",",
                      "choices_str": [
                        {
                          "value": "test_val"
                        },
                        {
                          "value": "other_val"
                        },
                        {
                          "value": "third_val"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "off",
                  "help": "the sibling scope, which owns nothing"
                }
              ]
            }
          ],
          "handler_prints": "flag0={sel0.flag0}"
        }
      ],
      "env_prefix": "MYAPP"
    },
    "argv": [
      "cmd",
      "--sel0",
      "on"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "flag0=test_val,other_val"
    },
    "env": {
      "MYAPP_FLAG0": "test_val,other_val"
    }
  },
  {
    "name": "pairwise: type=bool, presence=defaulted, negatable=true, co_required",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test",
      "commands": [
        {
          "name": "cmd",
